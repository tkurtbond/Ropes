library project Ropes is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "ropes";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnata", "-g");
      --  -gnata: enable assertion checking, so the Pre => contracts
      --  throughout Ropes are actually checked at runtime rather than
      --  compiling away to nothing. See AGENTS.md.
   end Compiler;

end Ropes;
