# Each line of data/lines.txt read whole by Ropes.Text_IO.Get_Line --
# including lines of 4096 and 4097 characters, either side of its
# internal 4096-character buffer -- and printed as its length, a space,
# and the line. The last line has no terminator. No RopeTool.Mod
# counterpart (Ropes.Mod has no I/O).
# Current_Input overload, FILE = "-" (passed on as an argument by
# Arg_Parser since arg_parser 264a098; before that it was dropped, and
# this fixture had to use "-- -").
program rope_tool
arg lines
arg -
input tests/data/lines.txt
status 0
output
5 hello
0 
9 two words
4096 
4097 
18 last, unterminated
