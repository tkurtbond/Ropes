with "../ropes.gpr";
with "arg_parser.gpr";

project Rope_Tool is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";

   for Main use ("rope_tool.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnata", "-g");
   end Compiler;

end Rope_Tool;
