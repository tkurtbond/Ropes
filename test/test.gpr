with "../ropes.gpr";

project Test is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";

   for Main use
     ("test_construction.adb", "test_balance.adb", "test_slice.adb", "test_insert.adb", "test_delete.adb",
      "test_compare.adb", "test_index.adb", "test_split.adb", "test_iterator.adb", "test_map.adb", "test_case.adb",
      "test_trim.adb", "test_concat_overloads.adb", "test_unbounded.adb", "test_repeat.adb", "test_escape.adb",
      "test_overwrite.adb", "test_head_tail.adb", "test_contains.adb", "test_split_visitor.adb",
      "test_text_io.adb",
      "test_stream_io.adb",
      "test_copy_slice.adb",
      "test_string_overloads.adb",
      "test_replace_slice.adb",
      "test_index_set.adb",
      "test_count.adb",
      "test_search_walk.adb",
      "test_find_token.adb",
      "test_translate.adb",
      "test_replace_element.adb",
      "test_hash.adb",
      "test_index_mapping.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnata", "-g");
   end Compiler;

end Test;
