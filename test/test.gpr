with "../ropes.gpr";

project Test is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";

   for Main use
     ("test_construction.adb", "test_balance.adb", "test_slice.adb", "test_insert.adb", "test_delete.adb",
      "test_compare.adb", "test_index.adb", "test_split.adb", "test_iterator.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnata", "-g");
   end Compiler;

end Test;
